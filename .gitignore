# Cached source downloads — 25 MB, and not ours to redistribute.
# Every build script re-fetches what it needs on first run, so a clean clone
# rebuilds everything from the cited originals rather than from a copy.
data/cache/

# Superseded implementations, kept only for local before/after comparison.
.attic/

# Generated intermediates. The figures they hold are re-derived by the
# verify_*.py scripts from the raw sources, so they are outputs, not inputs.
data/measured_typical.json

__pycache__/
*.pyc
.DS_Store

# NOTE: docs/ is deliberately NOT ignored. It is generated by
# data/build_site.py, but GitHub Pages publishes it directly from the branch,
# so committing it IS the deploy step.
